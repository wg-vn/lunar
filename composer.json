{
    "name": "wg-vn/lunar-core",
    "description": "Lunar's e-commerce core for Laravel, forked to run on spatie/laravel-activitylog 5, laravel/scout 11 and spatie/laravel-permission 8.",
    "keywords": [
        "lunar",
        "laravel",
        "ecommerce",
        "e-commerce",
        "headless",
        "store",
        "shop",
        "cart"
    ],
    "type": "library",
    "homepage": "https://github.com/wg-vn/lunar",
    "license": "MIT",
    "authors": [
        {
            "name": "wg-vn",
            "email": "wgarcia@vestednetworks.com",
            "role": "Developer"
        },
        {
            "name": "Lunar",
            "homepage": "https://lunarphp.io/"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-bcmath": "*",
        "ext-exif": "*",
        "ext-intl": "*",
        "laravel/framework": "^12.0|^13.0",
        "laravel/scout": "^11.7",
        "lukascivil/treewalker": "0.9.1",
        "lunarphp/nestedset": "^1.0",
        "spatie/laravel-activitylog": "^5.1",
        "spatie/laravel-blink": "^1.7.1",
        "spatie/laravel-medialibrary": "^11.12.7",
        "spatie/laravel-model-states": "^2.11",
        "spatie/laravel-permission": "^8.3",
        "spatie/php-structure-discoverer": "^2.3.1"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "1.29.0",
        "mockery/mockery": "^1.6.9",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpstan/phpstan": "^2.1.17",
        "spatie/invade": "^2.2"
    },
    "autoload": {
        "files": [
            "packages/core/src/helpers.php"
        ],
        "psr-4": {
            "Lunar\\Core\\": "packages/core/src",
            "Lunar\\Core\\Database\\Factories\\": "packages/core/database/factories",
            "Lunar\\Core\\Database\\Seeders\\": "packages/core/database/seeders",
            "Lunar\\Core\\Database\\State\\": "packages/core/database/state"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lunar\\Tests\\": "tests",
            "Lunar\\Tests\\Core\\": "tests/core"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lunar\\Core\\LunarServiceProvider"
            ]
        }
    },
    "replace": {
        "lunarphp/core": "self.version"
    },
    "scripts": {
        "pint": "pint packages/core tests/core",
        "test:pest": "pest --testsuite core --parallel",
        "test:phpstan": "phpstan analyse --no-progress",
        "test": [
            "@test:pest",
            "@test:phpstan"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
